# Server only. Never use a VITE_ prefix for secrets.
AGENT_NAME=delta.your-team.eth
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_PRIVATE_KEY=
# npm run keygen creates a separate Sepolia operator and saves its key locally.
FEE_BPS=5
SLIPPAGE_BPS=10

# Live delta-neutral trial. The model and Graph keys stay server-side.
OPENAI_API_KEY=
THE_GRAPH_API_KEY=
# Optional override; the default is the Uniswap V3 Ethereum subgraph documented by Uniswap.
THE_GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# Start a reproducible Ethereum mainnet fork with `npm run fork`, then fund its isolated account.
ETHEREUM_RPC_URL=
FORK_BLOCK_NUMBER=25965916
ANVIL_RPC_URL=http://127.0.0.1:8545
# Anvil's public first development key. Never use it on a public network.
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FORK_USDC_DONOR=

# Separate Hyperliquid testnet API wallet key and its master account address.
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_MIN_NOTIONAL_USD=10
# Optional demo-only replay: first hedge at 80%, then discard its confirmed response and reconcile after restart.
REPLAY_INITIAL_HEDGE_RATIO=
REPLAY_TIMEOUT_AFTER_SEND=

# Browser configuration is public. Use an RPC URL that permits browser requests.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_AGENT_NAME=delta.your-team.eth
